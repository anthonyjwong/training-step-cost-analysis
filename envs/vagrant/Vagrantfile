Vagrant.configure("2") do |config|
  config.vm.box      = "bento/ubuntu-24.04"
  config.vm.hostname = "proj1-vm"
  config.vm.network "private_network", ip: "172.16.10.11"

  # Share a folder between your computer and the VM
  config.vm.synced_folder "../..", "/home/vagrant/proj1"

  # Startup scripts
  config.vm.provision "shell", path: "setup.sh"

  # Set memory and CPU
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 16384 # 16 GB RAM
    vb.cpus   = 4     # 4 CPU cores
  end
end
